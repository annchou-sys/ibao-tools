    if(i>=tabs.length){cb(results);return;}
    tabs.forEach(function(t){t.classList.remove('cf-active');});
    panels.forEach(function(p){p.classList.remove('cf-active');});
    tabs[i].classList.add('cf-active');
    panels[i].classList.add('cf-active');
    setTimeout(function(){
      html2canvas(wrapper,{useCORS:true,scale:2,backgroundColor:'#fff'}).then(function(cv){
        results.push(cv);next(i+1);
      });
    },300);
  }
  next(0);
}

function saveSpecLocal(){
  var name=document.getElementById('specFileName').value.trim();
  var msg=document.getElementById('specSaveMsg');
  if(!name){msg.style.color='#c0392b';msg.textContent='請先填寫檔名';return;}
  msg.textContent='截圖中…';
  captureSpecTabs(function(canvases){
    var labels=['tab1','tab2','tab3'];
    canvases.forEach(function(cv,i){
      var a=document.createElement('a');
      a.download=name+'_'+labels[i]+'.jpg';
      a.href=cv.toDataURL('image/jpeg',0.95);
      a.click();
    });
    msg.style.color='#2e7d32';msg.textContent='✓ 已下載 3 張';
  });
}

function saveSpecDrive(){
  var name=document.getElementById('specFileName').value.trim();
  var msg=document.getElementById('specSaveMsg');
  if(!name){msg.style.color='#c0392b';msg.textContent='請先填寫檔名';return;}
  msg.textContent='準備中…';
  getGToken(function(){
    captureSpecTabs(function(canvases){
      var labels=['tab1','tab2','tab3'];
      var done=0;
      canvases.forEach(function(cv,i){
        cv.toBlob(function(blob){
          uploadBlob(blob,name+'_'+labels[i],{style:{color:'#888'},textContent:''},function(){
            done++;
            if(done===canvases.length){msg.style.color='#2e7d32';msg.textContent='✓ 已上傳 3 張到 Drive';}
          });
        },'image/jpeg',0.95);
      });
    });
  });
}

