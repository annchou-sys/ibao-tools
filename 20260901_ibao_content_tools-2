<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iBao 商品文字工具</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:13px;background:#f8f7f5;color:#1a1a1a}

/* Tab 列 */
.tab-bar{background:#fff;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;padding:0 20px;height:48px;gap:0}
.tab-bar h1{font-size:13px;font-weight:600;letter-spacing:.04em;margin-right:24px;white-space:nowrap}
.tab-btn{padding:0 18px;height:48px;border:none;background:transparent;cursor:pointer;font-size:12px;color:#888;font-family:inherit;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab-btn.on{color:#1a1a1a;font-weight:500;border-bottom-color:#1a1a1a}
.tab-btn:hover{color:#555}
.tab-panel{display:none;padding:24px 20px;max-width:760px;margin:0 auto}
.tab-panel.on{display:block}

/* 共用表單樣式 */
.form-group{background:#fff;border:1px solid #ddd;border-radius:6px;padding:14px;margin-bottom:10px}
.form-group label{font-size:10px;color:#888;letter-spacing:1px;display:block;margin-bottom:6px;font-weight:600;text-transform:uppercase}
.form-group input,.form-group textarea{width:100%;border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333}
.form-group input:focus,.form-group textarea:focus{border-color:#b89a6a}
.form-group .hint{font-size:10px;color:#b89a6a;margin-top:4px}
.actions{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap}
.btn-gen{background:#1a1a1a;color:#fff;border:none;border-radius:5px;padding:9px 20px;font-size:12px;font-family:inherit;cursor:pointer;letter-spacing:.5px}
.btn-gen:hover{background:#333}
.btn-copy{background:#f0ede8;color:#333;border:1px solid #ccc;border-radius:5px;padding:9px 20px;font-size:12px;font-family:inherit;cursor:pointer;display:none}
.btn-copy:hover{background:#e8e5e0}
.copy-ok{font-size:11px;color:#b89a6a;opacity:0;transition:opacity .3s;align-self:center}
.output-section{display:none;margin-bottom:20px}
.output-label{font-size:10px;color:#888;margin-bottom:6px;letter-spacing:1px;text-transform:uppercase}
textarea.code{width:100%;height:160px;border:1px solid #ddd;border-radius:5px;padding:10px;font-size:10px;font-family:monospace;color:#444;resize:vertical;outline:none;background:#fff}
.preview-section{display:none}
.preview-section h2{font-size:11px;color:#888;margin-bottom:10px;font-weight:normal;letter-spacing:1px;text-transform:uppercase}

/* 問題卡片 widget 預覽 */
.qs-scene{position:relative;width:100%!important;max-width:520px;aspect-ratio:1/1;margin:0 auto;overflow:hidden;background:#b5a090;font-family:Georgia,'Noto Serif TC',serif}
.qs-scene img{position:absolute;width:100%;height:100%;object-fit:cover;object-position:center}
.qs-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.22)}
.qs-header{position:absolute;bottom:44px;left:0;right:0;text-align:center;opacity:0;transform:translateY(8px);transition:opacity .4s ease,transform .4s ease}
.qs-title{font-size:11px!important;letter-spacing:3px;color:#fff;font-family:-apple-system,sans-serif;text-transform:uppercase}
.qs-brand{position:absolute;bottom:18px;left:24px;font-size:10px!important;letter-spacing:3px;color:#fff;opacity:.7;font-family:-apple-system,sans-serif}
.qs-ibao{position:absolute;bottom:18px;right:24px;font-size:10px!important;letter-spacing:3px;color:#fff;opacity:.7;font-family:-apple-system,sans-serif}
.qs-card{position:absolute;background:rgba(255,255,255,0.93);padding:11px 15px!important;width:52%!important;opacity:0;transform:translateX(-18px);transition:opacity .4s ease,transform .4s ease}
.qs-card.qs-r{text-align:right;transform:translateX(18px)}
.qs-card.qs-on,.qs-header.qs-on{opacity:1!important;transform:translate(0)!important}
.qs-num{font-family:Georgia,serif;font-style:italic;transform:skewX(-8deg);display:inline-block;font-size:14px!important;color:#1a1a1a;margin-right:5px!important;vertical-align:2px}
.qs-num-r{font-family:Georgia,serif;font-style:italic;transform:skewX(-8deg);display:inline-block;font-size:14px!important;color:#1a1a1a;margin-left:5px!important;vertical-align:2px}
.qs-line{display:inline-block;width:14px;border-bottom:.5px solid rgba(0,0,0,0.25);vertical-align:baseline;margin-right:6px!important}
.qs-line-r{display:inline-block;width:14px;border-bottom:.5px solid rgba(0,0,0,0.25);vertical-align:baseline;margin-left:6px!important}
.qs-text{font-size:13px!important;line-height:1.5!important;color:#1a1a1a!important;display:inline;vertical-align:baseline}
.qs-c1{top:15%;left:5%}.qs-c2{top:40%;right:5%;left:auto}.qs-c3{top:63%;left:5%}
.prev-btns{text-align:center;margin-top:8px;display:flex;gap:6px;justify-content:center}
.prev-btns button{font-size:11px;padding:5px 14px;border-radius:4px;cursor:pointer;font-family:inherit}

/* 規格表 */
.row2{display:flex;gap:10px}.row2 .form-group{flex:1}
.shared-row{display:flex;gap:6px;margin-bottom:5px}
.shared-row input{font-size:11px;padding:5px 7px}
.shared-row input:first-child{flex:0 0 90px}
.shared-row input:last-child{flex:1}
.add-btn,.del-btn{font-size:10px;padding:3px 8px;cursor:pointer;border-radius:3px;font-family:inherit;border:1px solid #ccc;background:#f5f5f5}
.add-btn:hover{background:#e8e8e8}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer crossorigin="anonymous"></script>
</head>
<body>

<div class="tab-bar">
  <h1>iBao 商品文字工具</h1>
  <button class="tab-btn on" onclick="switchTab(0,this)">動態問題卡片</button>
  <button class="tab-btn" onclick="switchTab(1,this)">尺寸規格表</button>
</div>

<!-- Tab 0: 動態問題卡片產生器 -->
<div class="tab-panel on" id="tab0">
  <div class="form-group">
    <label>底圖（Google Drive 連結或圖片網址）</label>
    <input type="text" id="imgUrl" placeholder="https://drive.google.com/file/d/...">
    <div class="hint" id="urlHint"></div>
  </div>
  <div class="form-group">
    <label>包款名稱（ABOUT 後面的文字）</label>
    <input type="text" id="bagName" placeholder="CONSTANCE">
  </div>
  <div class="form-group">
    <label>問題 1（左側）</label>
    <input type="text" id="q1" placeholder="怎麼撐才不會變型？">
  </div>
  <div class="form-group">
    <label>問題 2（右側）</label>
    <input type="text" id="q2" placeholder="內袋怎麼選才最適合？">
  </div>
  <div class="form-group">
    <label>問題 3（左側）</label>
    <input type="text" id="q3" placeholder="裡面顧好了，外在也能有保護嗎？">
  </div>
  <div class="actions">
    <button class="btn-gen" onclick="generateWidget()">產生 HTML</button>
    <button class="btn-copy" id="btnCopyWidget" onclick="copyWidget()">複製 HTML</button>
    <span class="copy-ok" id="copyOkWidget">✓ 已複製</span>
  </div>
  <div class="output-section" id="widgetOutput">
    <div class="output-label">貼入 CYB 自訂 HTML 區塊</div>
    <textarea class="code" id="widgetCode" readonly></textarea>
  </div>
  <div class="preview-section" id="widgetPreview">
    <h2>預覽</h2>
    <div id="previewWidget"></div>
    <div class="prev-btns">
      <button onclick="previewPlay()" style="background:#1a1a1a;color:#fff;border:none">▶ 播放</button>
      <button onclick="previewReset()" style="background:#fff;border:1px solid #ddd;color:#888">↺ 重置</button>
    </div>
    <div style="margin-top:12px;display:flex;flex-direction:column;gap:6px">
      <div style="display:flex;gap:6px;align-items:center">
        <input type="text" id="widgetFileName" placeholder="填檔名（必填）" style="flex:1;font-size:12px;border-radius:6px;border:1px solid #e0e0e0;background:#fafafa;padding:6px 9px;font-family:inherit;color:#1a1a1a">
        <span style="font-size:11px;color:#aaa">.jpg</span>
      </div>
      <div style="display:flex;gap:6px">
        <button onclick="saveWidgetLocal()" style="flex:1;padding:7px;font-size:11px;border:1px solid #ccc;border-radius:6px;background:#f0ede8;cursor:pointer;font-family:inherit">↓ 存到電腦</button>
        <button onclick="saveWidgetDrive()" style="flex:1;padding:7px;font-size:11px;border:none;border-radius:6px;background:#4285f4;color:#fff;cursor:pointer;font-family:inherit">▲ 存到 Drive</button>
      </div>
      <div id="widgetSaveMsg" style="font-size:11px;min-height:14px;text-align:center"></div>
    </div>
  </div>
</div>

<!-- Tab 1: 尺寸規格表產生器 -->
<div class="tab-panel" id="tab1">
  <div style="max-width:700px;margin:0 auto">
  <p style="font-size:11px;color:#888;margin-bottom:16px">填入資料，產出 CYB 三 Tab 規格表嵌入碼</p>

  <!-- 基本資料 -->
  <div class="form-group">
    <label>基本資料</label>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
      <input type="text" id="bagFull" placeholder="包款全名（如 CLASSIC FLAP 17）">
      <input type="text" id="seriesName" placeholder="系列名（如 CLASSIC FLAP）">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
      <select id="bagType" style="border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333">
        <option>方型包</option><option>梯型包</option><option>水桶型包</option>
        <option>多層型包</option><option>托特型包</option><option>薄型包</option><option>特殊型包</option>
      </select>
      <select id="sizeRange" style="border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333">
        <option>20cm 以下</option><option>21-26cm</option><option>27-31cm</option>
        <option>32-36cm</option><option>37-50cm</option>
      </select>
    </div>
  </div>

  <!-- Tab1 塑型愛包枕 -->
  <div class="form-group">
    <label>TAB 1 — 塑型愛包枕</label>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px">
      <input type="text" id="p1Model" placeholder="型號（如 CC17）">
      <select id="p1Core" style="border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333">
        <option>竹炭記憶棉</option><option>竹炭絲棉</option>
      </select>
      <input type="text" id="p1Weight" placeholder="克重（如 50g）">
    </div>
    <input type="text" id="p1Dim" placeholder="尺寸 cm（如 W15 D6 H8）" style="width:100%;border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333;margin-bottom:8px">
    <div style="font-size:10px;color:#888;margin-bottom:5px;font-weight:600;letter-spacing:1px">適用包款</div>
    <div id="p1SharedRows">
      <div class="shared-row">
        <input type="text" placeholder="品牌" class="p1brand">
        <input type="text" placeholder="包款（分號分隔）" class="p1bags">
        <button class="del-btn" onclick="this.parentElement.remove()">−</button>
      </div>
    </div>
    <button class="add-btn" onclick="addSharedRow('p1')" style="margin-top:6px">＋ 新增品牌</button>
  </div>

  <!-- Tab2 JOLIE 喬莉包 -->
  <div class="form-group">
    <label>TAB 2 — JOLIE 喬莉包</label>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px">
      <input type="text" id="p2Model" placeholder="型號（如 JC17-C）">
      <select id="p2Shape" style="border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333">
        <option>平口款</option><option>半月款</option><option>雲朵款</option>
        <option>翅膀款</option><option>圓底款</option><option>弧底款</option><option>外縫款</option>
      </select>
      <input type="text" id="p2Weight" placeholder="克重（如 35g）">
    </div>
    <input type="text" id="p2Dim" placeholder="尺寸 cm（如 W15.5 D5.5 H9）" style="width:100%;border:1px solid #e0e0e0;border-radius:4px;padding:7px 9px;font-size:12px;font-family:inherit;outline:none;color:#333;margin-bottom:8px">
    <div style="font-size:10px;color:#888;margin-bottom:5px;font-weight:600;letter-spacing:1px">適用包款</div>
    <div id="p2SharedRows">
      <div class="shared-row">
        <input type="text" placeholder="品牌" class="p2brand">
        <input type="text" placeholder="包款（分號分隔）" class="p2bags">
        <button class="del-btn" onclick="this.parentElement.remove()">−</button>
      </div>
    </div>
    <button class="add-btn" onclick="addSharedRow('p2')" style="margin-top:6px">＋ 新增品牌</button>
  </div>

  <!-- Tab3 同系列尺寸 -->
  <div class="form-group">
    <label>TAB 3 — 同系列其他尺寸</label>
    <div id="seriesRowsSpec">
      <div class="shared-row" style="gap:5px">
        <input type="text" placeholder="包款" style="flex:2">
        <input type="text" placeholder="枕型號" style="flex:1">
        <input type="text" placeholder="枕尺寸" style="flex:1.5">
        <input type="text" placeholder="袋型號" style="flex:1">
        <input type="text" placeholder="袋尺寸" style="flex:1.5">
        <label style="display:flex;align-items:center;gap:3px;font-size:10px;white-space:nowrap;flex-shrink:0"><input type="radio" name="curSpec" checked> ◀</label>
        <button class="del-btn" onclick="this.parentElement.remove()">−</button>
      </div>
    </div>
    <button class="add-btn" onclick="addSeriesRowSpec()" style="margin-top:6px">＋ 新增尺寸</button>
  </div>

  <div class="actions">
    <button class="btn-gen" onclick="generateSpec2()">產生規格表 HTML</button>
    <button class="btn-copy" id="btnCopySpec" onclick="copySpec()">複製 HTML</button>
    <span class="copy-ok" id="copyOkSpec">✓ 已複製</span>
  </div>
  <div class="output-section" id="specOutput">
    <div class="output-label">貼入 CYB 自訂 HTML 區塊</div>
    <textarea class="code" id="specCode" readonly></textarea>
  </div>
  <div class="preview-section" id="specPreview">
    <h2>預覽</h2>
    <div id="previewSpec"></div>
    <div style="margin-top:12px;display:flex;flex-direction:column;gap:6px">
      <div style="display:flex;gap:6px;align-items:center">
        <input type="text" id="specFileName" placeholder="填檔名（必填）" style="flex:1;font-size:12px;border-radius:6px;border:1px solid #e0e0e0;background:#fafafa;padding:6px 9px;font-family:inherit;color:#1a1a1a">
        <span style="font-size:11px;color:#aaa">_tab1/2/3.jpg</span>
      </div>
      <div style="display:flex;gap:6px">
        <button onclick="saveSpecLocal()" style="flex:1;padding:7px;font-size:11px;border:1px solid #ccc;border-radius:6px;background:#f0ede8;cursor:pointer;font-family:inherit">↓ 存到電腦（3張）</button>
        <button onclick="saveSpecDrive()" style="flex:1;padding:7px;font-size:11px;border:none;border-radius:6px;background:#4285f4;color:#fff;cursor:pointer;font-family:inherit">▲ 存到 Drive（3張）</button>
      </div>
      <div id="specSaveMsg" style="font-size:11px;min-height:14px;text-align:center"></div>
    </div>
  </div>
  </div>
</div>

<script>
function switchTab(n,btn){
  document.querySelectorAll('.tab-panel').forEach(function(p,i){p.classList.toggle('on',i===n);});
  document.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('on');});
  btn.classList.add('on');
}

/* ===== 動態問題卡片 ===== */
function convertUrl(url){
  var m=url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/)||url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if(m) return 'https://drive.google.com/thumbnail?id='+m[1]+'&sz=w800';
  return url;
}
document.getElementById('imgUrl').addEventListener('input',function(){
  var c=convertUrl(this.value.trim());
  document.getElementById('urlHint').textContent=(c!==this.value.trim())?'✓ 已自動轉換 Drive 連結':'';
});

function generateWidget(){
  var raw=document.getElementById('imgUrl').value.trim();
  var imgSrc=convertUrl(raw);
  var bagName=document.getElementById('bagName').value.trim().toUpperCase()||'ABOUT';
  var q1=document.getElementById('q1').value.trim();
  var q2=document.getElementById('q2').value.trim();
  var q3=document.getElementById('q3').value.trim();
  var css='<style>.qs-scene{position:relative;width:100%!important;max-width:560px;aspect-ratio:1/1;margin:0 auto;overflow:hidden;background:#b5a090;font-family:Georgia,serif}.qs-scene img{position:absolute;width:100%;height:100%;object-fit:cover}.qs-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.22)}.qs-header{position:absolute;bottom:44px;left:0;right:0;text-align:center;opacity:0;transform:translateY(8px);transition:opacity .4s,transform .4s}.qs-title{font-size:11px!important;letter-spacing:3px;color:#fff;font-family:-apple-system,sans-serif;text-transform:uppercase}.qs-brand{position:absolute;bottom:18px;left:24px;font-size:10px!important;letter-spacing:3px;color:#fff;opacity:.7;font-family:-apple-system,sans-serif}.qs-ibao{position:absolute;bottom:18px;right:24px;font-size:10px!important;letter-spacing:3px;color:#fff;opacity:.7;font-family:-apple-system,sans-serif}.qs-card{position:absolute;background:rgba(255,255,255,0.93);padding:11px 15px!important;width:52%!important;opacity:0;transform:translateX(-18px);transition:opacity .4s,transform .4s}.qs-card.qs-r{text-align:right;transform:translateX(18px)}.qs-card.qs-on,.qs-header.qs-on{opacity:1!important;transform:translate(0)!important}.qs-num{font-family:Georgia,serif;font-style:italic;display:inline-block;font-size:14px!important;color:#1a1a1a;margin-right:5px!important;vertical-align:2px}.qs-num-r{font-family:Georgia,serif;font-style:italic;display:inline-block;font-size:14px!important;color:#1a1a1a;margin-left:5px!important;vertical-align:2px}.qs-line{display:inline-block;width:14px;border-bottom:.5px solid rgba(0,0,0,0.25);vertical-align:baseline;margin-right:6px!important}.qs-line-r{display:inline-block;width:14px;border-bottom:.5px solid rgba(0,0,0,0.25);vertical-align:baseline;margin-left:6px!important}.qs-text{font-size:13px!important;line-height:1.5!important;color:#1a1a1a!important;display:inline;vertical-align:baseline}.qs-c1{top:15%;left:5%}.qs-c2{top:40%;right:5%;left:auto}.qs-c3{top:63%;left:5%}</style>';
  var html=css+'\n<div class="qs-scene" id="qs-s"><img src="'+imgSrc+'" alt="'+bagName+'"><div class="qs-overlay"></div><div class="qs-header" id="qs-h"><span class="qs-title">ABOUT '+bagName+' · 你最想知道的</span></div><div class="qs-brand">'+bagName+'</div><div class="qs-ibao">IBAO</div><div class="qs-card qs-c1" id="qs1"><span class="qs-num">1</span><span class="qs-line"></span><span class="qs-text">'+q1+'</span></div><div class="qs-card qs-c2 qs-r" id="qs2"><span class="qs-text">'+q2+'</span><span class="qs-line-r"></span><span class="qs-num-r">2</span></div><div class="qs-card qs-c3" id="qs3"><span class="qs-num">3</span><span class="qs-line"></span><span class="qs-text">'+q3+'</span></div></div>';
  html+='\n<script>(function(){var ids=["qs-h","qs1","qs2","qs3"],timers=[];function r(){timers.forEach(function(t){clearTimeout(t);});timers=[];ids.forEach(function(id){var e=document.getElementById(id);if(e)e.classList.remove("qs-on");});}function p(){r();ids.forEach(function(id,i){timers.push(setTimeout(function(){var e=document.getElementById(id);if(e)e.classList.add("qs-on");},i*550+300));});}var s=document.getElementById("qs-s");if("IntersectionObserver"in window){var o=new IntersectionObserver(function(e){if(e[0].isIntersecting)p();else r();},{threshold:0.3});o.observe(s);}else p();})();<\/script>';
  document.getElementById('widgetCode').value=html;
  document.getElementById('widgetOutput').style.display='block';
  document.getElementById('btnCopyWidget').style.display='inline-block';
  var pw=document.getElementById('previewWidget');
  pw.innerHTML='<div class="qs-scene" id="pqs-s"><img src="'+imgSrc+'" alt="'+bagName+'"><div class="qs-overlay"></div><div class="qs-header" id="pqs-h"><span class="qs-title">ABOUT '+bagName+' · 你最想知道的</span></div><div class="qs-brand">'+bagName+'</div><div class="qs-ibao">IBAO</div><div class="qs-card qs-c1" id="pqs1"><span class="qs-num">1</span><span class="qs-line"></span><span class="qs-text">'+q1+'</span></div><div class="qs-card qs-c2 qs-r" id="pqs2"><span class="qs-text">'+q2+'</span><span class="qs-line-r"></span><span class="qs-num-r">2</span></div><div class="qs-card qs-c3" id="pqs3"><span class="qs-num">3</span><span class="qs-line"></span><span class="qs-text">'+q3+'</span></div></div>';
  document.getElementById('widgetPreview').style.display='block';
  setTimeout(previewPlay,400);
}

var prevTimers=[];
