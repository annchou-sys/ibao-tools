<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iBao 商品文字工具</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer crossorigin="anonymous"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:13px;background:#f8f7f5;color:#1a1a1a}
.tab-bar{background:#fff;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;padding:0 20px;height:48px;gap:0}
.tab-bar h1{font-size:13px;font-weight:600;letter-spacing:.04em;margin-right:24px;white-space:nowrap}
.tab-btn{padding:0 18px;height:48px;border:none;background:transparent;cursor:pointer;font-size:12px;color:#888;font-family:inherit;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab-btn.on{color:#1a1a1a;font-weight:500;border-bottom-color:#1a1a1a}
.tab-btn:hover{color:#555}
.tab-panel{display:none;padding:24px 20px;max-width:800px;margin:0 auto}
.tab-panel.on{display:block}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-size:11px;font-weight:500;letter-spacing:.04em;color:#666;margin-bottom:5px}
.form-group input[type=text]{width:100%;padding:8px 10px;border:1px solid #ddd;background:#fff;font-size:13px;font-family:inherit;outline:none;border-radius:0}
.form-group input[type=text]:focus{border-color:#1a1a1a}
.hint{font-size:11px;color:#888;margin-top:4px;min-height:16px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.actions{display:flex;gap:8px;align-items:center;margin:20px 0 16px}
.btn-gen{padding:8px 20px;background:#1a1a1a;color:#fff;border:none;font-size:12px;font-family:inherit;cursor:pointer;letter-spacing:.04em}
.btn-gen:hover{background:#333}
.btn-copy{padding:8px 20px;background:#fff;color:#1a1a1a;border:1px solid #1a1a1a;font-size:12px;font-family:inherit;cursor:pointer;letter-spacing:.04em;display:none}
.btn-copy:hover{background:#f5f5f5}
.copy-ok{font-size:11px;color:#888;opacity:0;transition:opacity .3s}
.output-section{display:none;margin-bottom:20px}
.output-label{font-size:11px;color:#888;letter-spacing:.04em;margin-bottom:6px}
.code{width:100%;height:120px;padding:8px;font-size:10px;font-family:'SF Mono',Monaco,monospace;border:1px solid #ddd;background:#fafafa;resize:vertical;white-space:pre-wrap;word-break:break-all}
.preview-section{display:none;margin-bottom:20px}
.preview-section h2{font-size:11px;letter-spacing:.08em;color:#888;margin-bottom:12px}
.prev-btns{display:flex;gap:8px;margin-top:12px}
.prev-btns button{padding:6px 16px;font-size:12px;cursor:pointer;font-family:inherit}
.section{margin-bottom:20px;padding:16px;background:#fff;border:1px solid #e0e0e0}
.section-title{font-size:11px;font-weight:600;letter-spacing:.06em;color:#666;margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid #eee;text-transform:uppercase}
select{width:100%;padding:7px 10px;border:1px solid #ddd;background:#fff;font-size:13px;font-family:inherit;outline:none;border-radius:0}
select:focus{border-color:#1a1a1a}
.shared-group{padding:10px;border:1px solid #eee;background:#fafafa;margin-bottom:8px}
.shared-row{display:flex;gap:6px;margin-bottom:0}
.shared-row input{font-size:12px;padding:6px 8px}
.shared-row input:first-child{flex:0 0 110px}
.shared-row input:last-child{flex:1}
.add-btn{font-size:11px;padding:4px 12px;cursor:pointer;border:1px solid #bbb;background:#fff;color:#666;margin-top:6px}
.add-btn:hover{background:#f0f0f0}
.remove-btn{font-size:11px;padding:4px 8px;cursor:pointer;border:1px solid #ddd;background:#fff;color:#aaa;flex:0 0 auto}
.series-row{display:flex;gap:6px;margin-bottom:6px;align-items:center}
.series-row input{font-size:11px;padding:5px 6px}
.series-row .sr-name{flex:0 0 130px}
.series-row .sr-model{flex:0 0 72px}
.series-row .sr-dim{flex:1}
.series-row .sr-cur{font-size:10px;flex:0 0 auto;display:flex;align-items:center;gap:3px;white-space:nowrap;cursor:pointer}
.btn-row{display:flex;gap:10px;margin:20px 0 16px}
.main-btn{padding:9px 22px;font-size:12px;letter-spacing:.04em;cursor:pointer;border:1.5px solid #1a1a1a;background:#1a1a1a;color:#fff;font-family:inherit}
.main-btn:hover{background:#333}
.outline-btn{padding:9px 22px;font-size:12px;letter-spacing:.04em;cursor:pointer;border:1.5px solid #1a1a1a;background:#fff;color:#1a1a1a;font-family:inherit}
.outline-btn:hover{background:#f5f5f5}
.divider{width:100%;height:1px;background:#e0e0e0;margin:16px 0}
.code-box{width:100%;min-height:140px;padding:10px;font-size:10px;font-family:'SF Mono',Monaco,monospace;border:1px solid #ddd;background:#fafafa;white-space:pre-wrap;word-break:break-all;line-height:1.5;resize:vertical}
.copied{font-size:11px;color:#888;min-height:16px;margin-top:4px}
/* save bar */
.save-bar{background:#fff;border:1px solid #e0e0e0;padding:12px 16px;margin-bottom:20px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.save-bar input{flex:1;min-width:150px;padding:7px 10px;border:1px solid #ddd;font-size:12px;font-family:inherit;outline:none}
.save-bar input:focus{border-color:#1a1a1a}
.save-bar button{padding:7px 16px;font-size:12px;cursor:pointer;font-family:inherit;border:1px solid #1a1a1a;white-space:nowrap}
.btn-save-local{background:#1a1a1a;color:#fff}
.btn-save-local:hover{background:#333}
.btn-save-drive{background:#fff;color:#1a1a1a}
.btn-save-drive:hover{background:#f5f5f5}
.save-msg{font-size:11px;color:#888;width:100%}
</style>
</head>
<body>

<div class="tab-bar">
  <h1>iBao 商品文字工具</h1>
  <button class="tab-btn on" onclick="switchTab(0,this)">動態問題卡片</button>
  <button class="tab-btn" onclick="switchTab(1,this)">尺寸規格表</button>
</div>

<!-- ===== Tab 0: 動態問題卡片產生器 ===== -->
<div class="tab-panel on" id="tab0">

  <div class="save-bar">
    <input type="text" id="w-filename" placeholder="檔名（存圖用）">
    <button class="btn-save-local" onclick="saveWidgetLocal()">存到電腦</button>
    <button class="btn-save-drive" onclick="saveWidgetDrive()">存到 Drive</button>
    <div class="save-msg" id="w-save-msg"></div>
  </div>

  <div class="form-group">
    <label>底圖（Google Drive 連結或圖片網址）</label>
    <input type="text" id="imgUrl" placeholder="https://drive.google.com/file/d/..." oninput="convertUrl()">
    <div class="hint" id="urlHint"></div>
  </div>
  <div class="form-group">
    <label>包款名稱（ABOUT 後面的文字）</label>
    <input type="text" id="bagName" placeholder="CONSTANCE">
  </div>
  <div class="form-group">
    <label>問題 1（左側）</label>
    <input type="text" id="q1" placeholder="怎麼撐才不會變型？">
  </div>
  <div class="form-group">
    <label>問題 2（右側）</label>
    <input type="text" id="q2" placeholder="內袋怎麼選才最適合？">
  </div>
  <div class="form-group">
    <label>問題 3（左側）</label>
    <input type="text" id="q3" placeholder="裡面顧好了，外在也能有保護嗎？">
  </div>
  <div class="actions">
    <button class="btn-gen" onclick="generateWidget()">產生 HTML</button>
    <button class="btn-copy" id="btnCopyWidget" onclick="copyWidget()">複製 HTML</button>
    <span class="copy-ok" id="copyOkWidget">✓ 已複製</span>
  </div>
  <div class="output-section" id="widgetOutput">
    <div class="output-label">貼入 CYB 自訂 HTML 區塊</div>
    <textarea class="code" id="widgetCode" readonly></textarea>
  </div>
  <div class="preview-section" id="widgetPreview">
    <h2>預覽</h2>
    <div id="previewWidget"></div>
    <div class="prev-btns">
      <button onclick="previewPlay()" style="background:#1a1a1a;color:#fff;border:none">▶ 播放</button>
      <button onclick="previewReset()" style="background:#fff;border:1px solid #ddd;color:#888">↺ 重置</button>
    </div>
  </div>
</div>

<!-- ===== Tab 1: 尺寸規格表產生器 ===== -->
<div class="tab-panel" id="tab1">

  <div class="save-bar">
    <input type="text" id="s-filename" placeholder="檔名（存圖用，自動加 _tab1/2/3）">
    <button class="btn-save-local" onclick="saveSpecLocal()">存到電腦</button>
    <button class="btn-save-drive" onclick="saveSpecDrive()">存到 Drive</button>
    <div class="save-msg" id="s-save-msg"></div>
  </div>

  <div class="section">
    <div class="section-title">基本資料</div>
    <div class="row2">
      <div class="form-group"><label>包款全名（如 CLASSIC FLAP 17）</label><input id="bagFull" placeholder="CLASSIC FLAP 17"></div>
      <div class="form-group"><label>系列名（如 CLASSIC FLAP）</label><input id="seriesName" placeholder="CLASSIC FLAP"></div>
    </div>
    <div class="row2">
      <div class="form-group"><label>包型</label>
        <select id="bagType"><option>方型包</option><option>梯型包</option><option>水桶型包</option><option>多層型包</option><option>托特型包</option><option>薄型包</option><option>特殊型包</option></select>
      </div>
      <div class="form-group"><label>尺寸區間</label>
        <select id="sizeRange"><option>20cm 以下</option><option>21-26cm</option><option>27-31cm</option><option>32-36cm</option><option>37-50cm</option></select>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">TAB 1 — 塑型愛包枕</div>
    <div class="row3">
      <div class="form-group"><label>型號</label><input id="p1Model" placeholder="CC17"></div>
      <div class="form-group"><label>枕心</label>
        <select id="p1Core"><option>竹炭記憶棉</option><option>竹炭絲棉</option></select>
      </div>
      <div class="form-group"><label>克重</label><input id="p1Weight" placeholder="50g"></div>
    </div>
    <div class="form-group"><label>尺寸 cm（W D H）</label><input id="p1Dim" placeholder="W15 D6 H8"></div>
    <div class="form-group"><label>適用包款</label></div>
    <div id="p1Shared">
      <div class="shared-group">
        <div class="shared-row"><input placeholder="品牌" class="p1brand"><input placeholder="包款（分號分隔）" class="p1bags"><button class="remove-btn" onclick="this.closest('.shared-group').remove()">✕</button></div>
      </div>
    </div>
    <button class="add-btn" onclick="addShared('p1')">＋ 新增品牌</button>
  </div>

  <div class="section">
    <div class="section-title">TAB 2 — JOLIE 喬莉包</div>
    <div class="row3">
      <div class="form-group"><label>型號</label><input id="p2Model" placeholder="JC17-C"></div>
      <div class="form-group"><label>形狀</label>
        <select id="p2Shape"><option>平口款</option><option>半月款</option><option>雲朵款</option><option>翅膀款</option><option>圓底款</option><option>弧底款</option><option>外縫款</option></select>
      </div>
      <div class="form-group"><label>克重</label><input id="p2Weight" placeholder="35g"></div>
    </div>
    <div class="form-group"><label>尺寸 cm（W D H）</label><input id="p2Dim" placeholder="W15.5 D5.5 H9"></div>
    <div class="form-group"><label>適用包款</label></div>
    <div id="p2Shared">
      <div class="shared-group">
        <div class="shared-row"><input placeholder="品牌" class="p2brand"><input placeholder="包款（分號分隔）" class="p2bags"><button class="remove-btn" onclick="this.closest('.shared-group').remove()">✕</button></div>
      </div>
    </div>
    <button class="add-btn" onclick="addShared('p2')">＋ 新增品牌</button>
  </div>

  <div class="section">
    <div class="section-title">TAB 3 — 同系列其他尺寸</div>
    <div id="seriesRows">
      <div class="series-row">
        <input class="sr-name" placeholder="包款（如 CF17 方胖 Mini）">
        <input class="sr-model" placeholder="枕型號">
        <input class="sr-dim" placeholder="枕尺寸">
        <input class="sr-model" placeholder="袋型號">
        <input class="sr-dim" placeholder="袋尺寸">
        <label class="sr-cur"><input type="radio" name="curItem" checked> ◀</label>
        <button class="remove-btn" onclick="this.parentElement.remove()">✕</button>
      </div>
    </div>
    <button class="add-btn" onclick="addSeries()">＋ 新增尺寸</button>
  </div>

  <div class="btn-row">
    <button class="main-btn" onclick="generateSpec()">產生預覽 + 嵌入碼</button>
    <button class="outline-btn" onclick="resetSpec()">清除</button>
  </div>

  <div class="divider"></div>
  <p style="font-size:11px;color:#888;letter-spacing:.04em;margin-bottom:12px">預覽</p>
  <div id="previewSpec"></div>

  <p style="font-size:11px;color:#888;letter-spacing:.04em;margin:20px 0 8px">嵌入碼（複製貼進 CYB）</p>
  <textarea class="code-box" id="specCode" readonly></textarea>
  <button class="outline-btn" style="margin-top:8px" onclick="copySpec()">複製</button>
  <p class="copied" id="copyOkSpec"></p>
</div>

<script>
const CLIENT_ID = '999765668036-hgeritojptqndlh2fi2ht005jant5ai5.apps.googleusercontent.com';
let tokenClient, accessToken;

function switchTab(n, btn) {
  document.querySelectorAll('.tab-panel').forEach((p,i) => p.classList.toggle('on', i===n));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
}

// ===== Drive Auth =====
function initDrive(callback) {
  if (accessToken) { callback(); return; }
  if (!window.google) { alert('Google 授權腳本未載入，請確認網路連線。'); return; }
  tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: CLIENT_ID,
    scope: 'https://www.googleapis.com/auth/drive.file',
    callback: (resp) => { if (resp.error) return; accessToken = resp.access_token; callback(); }
  });
  tokenClient.requestAccessToken();
}

async function uploadToDrive(filename, blob) {
  const meta = JSON.stringify({ name: filename, parents: [] });
  const form = new FormData();
  form.append('metadata', new Blob([meta], { type: 'application/json' }));
  form.append('file', blob);
  const res = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {
    method: 'POST', headers: { Authorization: 'Bearer ' + accessToken }, body: form
  });
  return res.json();
}

// ===== Tab 0: 問題卡片 =====
function convertUrl() {
  const raw = document.getElementById('imgUrl').value.trim();
  const hint = document.getElementById('urlHint');
  const m = raw.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (m) {
    const direct = 'https://lh3.googleusercontent.com/d/' + m[1];
    document.getElementById('imgUrl').value = direct;
    hint.textContent = '✓ 已轉換為可載入格式';
    hint.style.color = '#2a9d2a';
  } else if (raw.startsWith('http')) {
    hint.textContent = '網址格式看起來OK';
    hint.style.color = '#888';
  } else {
    hint.textContent = '';
  }
}

function generateWidget() {
  const imgUrl = document.getElementById('imgUrl').value.trim();
  const bagName = document.getElementById('bagName').value.trim() || 'YOUR BAG';
  const q1 = document.getElementById('q1').value.trim() || '問題一';
  const q2 = document.getElementById('q2').value.trim() || '問題二';
  const q3 = document.getElementById('q3').value.trim() || '問題三';

  const html = buildWidgetHTML(imgUrl, bagName, q1, q2, q3);
  document.getElementById('widgetCode').value = html;
  document.getElementById('widgetOutput').style.display = 'block';
  document.getElementById('btnCopyWidget').style.display = 'inline-block';
  document.getElementById('widgetPreview').style.display = 'block';
  document.getElementById('previewWidget').innerHTML = html;
  const scripts = document.getElementById('previewWidget').querySelectorAll('script');
  scripts.forEach(s => { const ns = document.createElement('script'); ns.textContent = s.textContent; s.parentNode.replaceChild(ns, s); });
}

function buildWidgetHTML(imgUrl, bagName, q1, q2, q3) {
  return `<style>
.ibao-widget{position:relative;width:100%;max-width:720px;margin:0 auto;background:#1a1a1a;overflow:hidden;aspect-ratio:16/9}
.ibao-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 1s}
.ibao-bg.show{opacity:.45}
.ibao-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:5%}
.ibao-about{font-size:clamp(10px,1.4vw,14px);letter-spacing:.25em;color:#aaa;margin-bottom:8px;opacity:0;transition:opacity .8s}
.ibao-about.show{opacity:1}
.ibao-title{font-size:clamp(22px,4vw,42px);letter-spacing:.18em;color:#fff;font-weight:300;text-align:center;margin-bottom:32px;opacity:0;transition:opacity .8s .3s}
.ibao-title.show{opacity:1}
.ibao-qs{width:100%;display:flex;flex-direction:column;gap:10px}
.ibao-q{font-size:clamp(12px,1.8vw,18px);color:#e0e0e0;letter-spacing:.05em;opacity:0;transform:translateY(10px);transition:opacity .6s,transform .6s}
.ibao-q.show{opacity:1;transform:translateY(0)}
.ibao-q.left{text-align:left;padding-left:5%}
.ibao-q.right{text-align:right;padding-right:5%}
.ibao-q-num{font-size:.75em;color:#888;margin-right:6px}
</style>
<div class="ibao-widget" id="ibao-w">
  <div class="ibao-bg" id="ibao-bg" style="background-image:url('${imgUrl}')"></div>
  <div class="ibao-overlay">
    <div class="ibao-about" id="ibao-about">ABOUT</div>
    <div class="ibao-title" id="ibao-title">${bagName}</div>
    <div class="ibao-qs">
      <div class="ibao-q left" id="ibao-q1"><span class="ibao-q-num">01</span>${q1}</div>
      <div class="ibao-q right" id="ibao-q2"><span class="ibao-q-num">02</span>${q2}</div>
      <div class="ibao-q left" id="ibao-q3"><span class="ibao-q-num">03</span>${q3}</div>
    </div>
  </div>
</div>
<script>
(function(){
  function play(){
    var bg=document.getElementById('ibao-bg');
    var ab=document.getElementById('ibao-about');
    var ti=document.getElementById('ibao-title');
    var q1=document.getElementById('ibao-q1');
    var q2=document.getElementById('ibao-q2');
    var q3=document.getElementById('ibao-q3');
    bg.classList.add('show');
    setTimeout(function(){ab.classList.add('show');},400);
    setTimeout(function(){ti.classList.add('show');},800);
    setTimeout(function(){q1.classList.add('show');},1400);
    setTimeout(function(){q2.classList.add('show');},1900);
    setTimeout(function(){q3.classList.add('show');},2400);
  }
  var obs=new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){play();obs.disconnect();}
  },{threshold:0.3});
  obs.observe(document.getElementById('ibao-w'));
})();
<\/script>`;
}

function previewPlay() {
  ['ibao-bg','ibao-about','ibao-title','ibao-q1','ibao-q2','ibao-q3'].forEach(id => {
    const el = document.getElementById(id); if (el) el.classList.add('show');
  });
}

function previewReset() {
  ['ibao-bg','ibao-about','ibao-title','ibao-q1','ibao-q2','ibao-q3'].forEach(id => {
    const el = document.getElementById(id); if (el) el.classList.remove('show');
  });
  setTimeout(previewPlay, 200);
}

function copyWidget() {
  navigator.clipboard.writeText(document.getElementById('widgetCode').value).then(() => {
    const ok = document.getElementById('copyOkWidget');
    ok.style.opacity = '1'; setTimeout(() => ok.style.opacity = '0', 2000);
  });
}

async function saveWidgetLocal() {
  const fn = document.getElementById('w-filename').value.trim();
  if (!fn) { document.getElementById('w-save-msg').textContent = '請填檔名'; return; }
  const pw = document.getElementById('previewWidget');
  if (!pw.innerHTML) { document.getElementById('w-save-msg').textContent = '請先產生 HTML'; return; }
  document.getElementById('w-save-msg').textContent = '截圖中…';
  previewPlay();
  setTimeout(async () => {
    const canvas = await html2canvas(pw, { scale: 2, useCORS: true, backgroundColor: '#1a1a1a' });
    const a = document.createElement('a'); a.download = fn + '.jpg';
    a.href = canvas.toDataURL('image/jpeg', 0.92); a.click();
    document.getElementById('w-save-msg').textContent = '✓ 已下載';
  }, 2600);
}

async function saveWidgetDrive() {
  const fn = document.getElementById('w-filename').value.trim();
  if (!fn) { document.getElementById('w-save-msg').textContent = '請填檔名'; return; }
  const pw = document.getElementById('previewWidget');
  if (!pw.innerHTML) { document.getElementById('w-save-msg').textContent = '請先產生 HTML'; return; }
  initDrive(async () => {
    document.getElementById('w-save-msg').textContent = '截圖中…';
    previewPlay();
    setTimeout(async () => {
      const canvas = await html2canvas(pw, { scale: 2, useCORS: true, backgroundColor: '#1a1a1a' });
      canvas.toBlob(async (blob) => {
        document.getElementById('w-save-msg').textContent = '上傳中…';
        const res = await uploadToDrive(fn + '.jpg', blob);
        document.getElementById('w-save-msg').textContent = res.id ? '✓ 已上傳到 Drive' : '上傳失敗';
      }, 'image/jpeg', 0.92);
    }, 2600);
  });
}

// ===== Tab 1: 規格表 =====
function addShared(prefix) {
  const container = document.getElementById(prefix + 'Shared');
  const group = document.createElement('div');
  group.className = 'shared-group';
  group.innerHTML = `<div class="shared-row"><input placeholder="品牌" class="${prefix}brand"><input placeholder="包款（分號分隔）" class="${prefix}bags"><button class="remove-btn" onclick="this.closest('.shared-group').remove()">✕</button></div>`;
  container.appendChild(group);
}

function addSeries() {
  const container = document.getElementById('seriesRows');
  const row = document.createElement('div');
  row.className = 'series-row';
  row.innerHTML = `<input class="sr-name" placeholder="包款"><input class="sr-model" placeholder="枕型號"><input class="sr-dim" placeholder="枕尺寸"><input class="sr-model" placeholder="袋型號"><input class="sr-dim" placeholder="袋尺寸"><label class="sr-cur"><input type="radio" name="curItem"> ◀</label><button class="remove-btn" onclick="this.parentElement.remove()">✕</button>`;
  container.appendChild(row);
}

function getSharedRows(prefix) {
  const brands = document.querySelectorAll('.' + prefix + 'brand');
  const result = [];
  brands.forEach(el => {
    const brand = el.value.trim();
    const bags = el.nextElementSibling.value.trim();
    if (brand && bags) result.push({ brand, bags });
  });
  return result;
}

function getSeriesData() {
  const rows = document.querySelectorAll('.series-row');
  const result = [];
  rows.forEach(row => {
    const inputs = row.querySelectorAll('input');
    result.push({
      name: inputs[0].value.trim(), pModel: inputs[1].value.trim(), pDim: inputs[2].value.trim(),
      jModel: inputs[3].value.trim(), jDim: inputs[4].value.trim(), current: inputs[5].checked
    });
  });
  return result;
}

function makeSharedTable(data) {
  let html = '<table><colgroup><col><col></colgroup><tbody>'
    + '<tr><th class="left" style="line-height:1.5!important;width:110px;padding:8px!important;">品牌</th>'
    + '<th class="left" style="line-height:1.5!important;padding:8px!important;">包款</th></tr>';
  data.forEach(r => {
    html += `<tr><td class="brand" style="line-height:1.5!important;padding:8px!important;">${r.brand}</td>`
      + `<td class="shared" style="line-height:1.5!important;padding:8px!important;">${r.bags}</td></tr>`;
  });
  return html + '</tbody></table>';
}

function makeSeriesTable(data) {
  let html = '<table><colgroup><col><col><col><col><col></colgroup><tbody>'
    + '<tr><th class="left" style="line-height:1.5!important;width:125px;padding:8px!important;">包款</th>'
    + '<th style="line-height:1.5!important;padding:8px!important;">枕型號</th>'
    + '<th style="line-height:1.5!important;padding:8px!important;">枕尺寸 cm</th>'
    + '<th class="divider" style="line-height:1.5!important;padding:8px!important;">袋型號</th>'
    + '<th style="line-height:1.5!important;padding:8px!important;">袋尺寸 cm</th></tr>';
  data.forEach(r => {
    const bg = r.current ? ' style="background:#efefef;"' : '';
    const arrow = r.current ? ' ◀' : '';
    html += `<tr${bg}><td class="label" style="line-height:1.5!important;padding:8px!important;">${r.name}${arrow}</td>`
      + `<td class="model" style="line-height:1.5!important;padding:8px!important;">${r.pModel}</td>`
      + `<td class="dim" style="line-height:1.5!important;padding:8px!important;">${r.pDim}</td>`
      + `<td class="model divider" style="line-height:1.5!important;padding:8px!important;">${r.jModel}</td>`
      + `<td class="dim" style="line-height:1.5!important;padding:8px!important;">${r.jDim}</td></tr>`;
  });
  return html + '</tbody></table>';
}

