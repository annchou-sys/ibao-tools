function resetSpec() {
  document.querySelectorAll('#tab1 input[type=text]').forEach(el => el.value = '');
  document.getElementById('previewSpec').innerHTML = '';
  document.getElementById('specCode').value = '';
  document.getElementById('copyOkSpec').textContent = '';
}

function copySpec() {
  navigator.clipboard.writeText(document.getElementById('specCode').value).then(() => {
    const m = document.getElementById('copyOkSpec');
    m.textContent = '✓ 已複製';
    setTimeout(() => m.textContent = '', 2000);
  });
}

async function saveSpecLocal() {
  const fn = document.getElementById('s-filename').value.trim();
  if (!fn) { document.getElementById('s-save-msg').textContent = '請填檔名'; return; }
  const preview = document.getElementById('previewSpec');
  if (!preview.innerHTML) { document.getElementById('s-save-msg').textContent = '請先產生規格表'; return; }
  document.getElementById('s-save-msg').textContent = '截圖中…';
  const tabs = ['p1', 'p2', 'p3'];
  for (let i = 0; i < 3; i++) {
    const wrapper = preview.querySelector('.cf-wrapper');
    if (!wrapper) break;
    const panels = wrapper.querySelectorAll('.cf-panel');
    const tabBtns = wrapper.querySelectorAll('.cf-tab');
    panels.forEach((p, j) => { p.classList.toggle('cf-active', j === i); });
    tabBtns.forEach((b, j) => { b.classList.toggle('cf-active', j === i); });
    await new Promise(r => setTimeout(r, 200));
    const canvas = await html2canvas(wrapper, { scale: 2, useCORS: true, backgroundColor: '#fff' });
    const a = document.createElement('a'); a.download = fn + '_tab' + (i + 1) + '.jpg';
    a.href = canvas.toDataURL('image/jpeg', 0.92); a.click();
    await new Promise(r => setTimeout(r, 300));
  }
  document.getElementById('s-save-msg').textContent = '✓ 已下載 3 張';
}

async function saveSpecDrive() {
  const fn = document.getElementById('s-filename').value.trim();
  if (!fn) { document.getElementById('s-save-msg').textContent = '請填檔名'; return; }
  const preview = document.getElementById('previewSpec');
  if (!preview.innerHTML) { document.getElementById('s-save-msg').textContent = '請先產生規格表'; return; }
  initDrive(async () => {
    document.getElementById('s-save-msg').textContent = '截圖上傳中…';
    for (let i = 0; i < 3; i++) {
      const wrapper = preview.querySelector('.cf-wrapper');
      if (!wrapper) break;
      const panels = wrapper.querySelectorAll('.cf-panel');
      const tabBtns = wrapper.querySelectorAll('.cf-tab');
      panels.forEach((p, j) => { p.classList.toggle('cf-active', j === i); });
      tabBtns.forEach((b, j) => { b.classList.toggle('cf-active', j === i); });
      await new Promise(r => setTimeout(r, 200));
      const canvas = await html2canvas(wrapper, { scale: 2, useCORS: true, backgroundColor: '#fff' });
      await new Promise(resolve => {
        canvas.toBlob(async (blob) => {
          await uploadToDrive(fn + '_tab' + (i + 1) + '.jpg', blob);
          resolve();
        }, 'image/jpeg', 0.92);
      });
      await new Promise(r => setTimeout(r, 300));
    }
    document.getElementById('s-save-msg').textContent = '✓ 已上傳 3 張到 Drive';
  });
}
